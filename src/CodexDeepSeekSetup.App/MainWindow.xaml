<Window x:Class="CodexDeepSeekSetup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex + DeepSeek 安装助手" Width="820" Height="720"
        MinWidth="720" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="#F4F7FB" FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#111827" Padding="30,24">
            <StackPanel>
                <TextBlock Text="Codex + DeepSeek 安装助手" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="只安装 OpenAI 官方 Codex；不安装代理、VPN 或第三方重打包客户端。" Foreground="#CBD5E1" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,22">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1  检查并安装 Codex" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="推荐 Windows 10 22H2（19045）或 Windows 11 x64。19041—19044 可继续尝试官方离线部署。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#475569" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="检查电脑" Click="CheckButton_Click" />
                            <Button Content="下载并安装" Click="InstallButton_Click" Background="#2563EB" Foreground="White" />
                            <Button Content="实验性解包运行" Click="PortableInstallButton_Click" IsEnabled="{Binding CanUsePortable, Mode=OneWay}" ToolTip="仅在官方离线部署失败时使用；不重新签名或封包" />
                        </StackPanel>
                        <TextBlock Text="实验模式只解压通过官方签名和包身份校验的 MSIX，可能缺少更新、通知、协议关联或沙盒能力。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#B45309" />
                        <ProgressBar Height="7" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2  准备 DeepSeek API Key" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="在 DeepSeek 官方平台完成注册和实名认证；充值后进入 API Keys 页面创建 Key。身份资料只在 DeepSeek 官方网页填写，本程序不会读取。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#475569" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开 DeepSeek 平台" Tag="https://platform.deepseek.com/" Click="OpenLink_Click" />
                            <Button Content="打开 API Keys" Tag="https://platform.deepseek.com/api_keys" Click="OpenLink_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="3  验证并配置" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="API Key 将写入 Windows 凭据管理器，不会写进 config.toml、日志或安装状态。" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="#475569" />
                        <PasswordBox x:Name="ApiKeyBox" Height="38" Padding="10,7" PasswordChar="●" ToolTip="粘贴 sk- 开头的 DeepSeek API Key" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="验证并配置 Codex" Click="ConfigureButton_Click" Background="#059669" Foreground="White" />
                            <Button Content="启动 Codex" Click="LaunchButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="30,14">
            <DockPanel>
                <Ellipse Width="10" Height="10" Fill="#2563EB" Margin="0,0,10,0" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
