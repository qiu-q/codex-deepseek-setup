<Window x:Class="CodexDeepSeekSetup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex + DeepSeek 安装助手" Width="960" Height="780" MinWidth="820" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI" Loaded="MainWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Codex + DeepSeek 安装助手" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="官方 Codex 安装、DeepSeek 配置与清理" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="OpenMaintenanceButton" Content="检测安装与清理数据" Click="OpenMaintenanceButton_Click" IsEnabled="{Binding CanOpenMaintenance}" Margin="0"/><TextBlock Text="{Binding InstallationSummary}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="430" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PrimaryBrush}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="下载与安装" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource BorderBrush}" Margin="8,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PrimaryBrush}"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="配置 DeepSeek" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <Rectangle Grid.Column="3" Height="1" Fill="{StaticResource BorderBrush}" Margin="8,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PrimaryBrush}"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBlock Text="完成" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22">
                <Border Visibility="{Binding NeedsBuiltInAdministratorCompatibility, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FDF6EC" BorderBrush="#F3D19E" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="内置 Administrator 需要开启兼容模式" FontWeight="SemiBold" Foreground="#B88230"/><TextBlock Text="保存其他工作后启用管理员批准模式；Windows 会在 15 秒后自动重启并重新打开本助手。" TextWrapping="Wrap" Foreground="#B88230" Margin="0,4,16,0"/></StackPanel><Button x:Name="EnableAdministratorCompatibilityButton" Grid.Column="1" Content="启用兼容并重启" Click="EnableAdministratorCompatibilityButton_Click" IsEnabled="{Binding CanEnableBuiltInAdministratorCompatibility}" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningBrush}" Foreground="White" VerticalAlignment="Center" Margin="0"/></Grid>
                </Border>

                <Border x:Name="InstallStepPanel" Visibility="{Binding IsInstallStep, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="下载并安装 Codex" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="下载与安装分开执行。先校验官方文件，再授权 Windows 安装；安装失败不需要重复下载。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,14"/>
                        <Border Style="{StaticResource InfoAlert}"><TextBlock Text="安装阶段的系统弹窗要求 Windows 管理员密码，不是 DeepSeek API Key。" Foreground="#337ECC" TextWrapping="Wrap"/></Border>
                        <Border Style="{StaticResource InnerBorder}" Margin="0,14,0,0"><StackPanel><TextBlock Text="保存与安装位置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="安装包默认保存到助手旁的 Downloads。Codex 由 Windows 管理，只能选择可用的 AppX 磁盘。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="安装包保存到" VerticalAlignment="Center"/><TextBox x:Name="DownloadDirectoryTextBox" Grid.Column="1" Text="{Binding DownloadDirectory, Mode=OneWay}" IsReadOnly="True"/><Button x:Name="BrowseDownloadDirectoryButton" Grid.Column="2" Content="选择目录" Click="BrowseDownloadDirectoryButton_Click" Margin="10,0,0,0"/></Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Codex 安装磁盘" VerticalAlignment="Center"/><ComboBox x:Name="InstallDriveComboBox" Grid.Column="1" ItemsSource="{Binding InstallDriveChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="RootPath" SelectedValue="{Binding SelectedInstallDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <TextBlock Text="{Binding InstallationSummary}" Foreground="#529B2E" TextWrapping="Wrap" Margin="125,10,0,0"/>
                        </StackPanel></Border>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource InnerBorder}"><StackPanel><TextBlock x:Name="DownloadPhaseLabel" Text="阶段 1 · 下载并校验" FontSize="16" FontWeight="SemiBold" Foreground="#337ECC"/><TextBlock Text="下载 MSIX 和许可证，校验包身份及数字签名。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="DownloadCodexButton" Content="下载并校验" Click="DownloadButton_Click" IsEnabled="{Binding CanDownload}" Style="{StaticResource PrimaryButton}"/><Button Content="重新检查" Click="CheckButton_Click" IsEnabled="{Binding CanDownload}"/></StackPanel></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource InnerBorder}"><StackPanel><TextBlock x:Name="InstallPhaseLabel" Text="阶段 2 · 安装 Codex" FontSize="16" FontWeight="SemiBold" Foreground="#529B2E"/><TextBlock Text="使用已校验文件部署，仅此阶段可能请求管理员授权。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/><Button x:Name="InstallCodexButton" Content="安装 Codex" Click="InstallButton_Click" IsEnabled="{Binding CanInstall}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"/></StackPanel></Border>
                        </Grid>
                        <Border x:Name="ProgressPanel" Style="{StaticResource InnerBorder}" Margin="0,14,0,0"><StackPanel><TextBlock Text="{Binding ProgressTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ProgressDetail}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,10"/><Grid><TextBlock Text="{Binding CurrentFileName}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TransferSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/></Grid><ProgressBar x:Name="FileProgressBar" Height="8" Minimum="0" Maximum="100" Value="{Binding FileProgress, Mode=OneWay}" IsIndeterminate="{Binding IsFileProgressIndeterminate, Mode=OneWay}" Margin="0,7,0,11"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="总体进度" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0"/><ProgressBar x:Name="OverallProgressBar" Height="7" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}"/></DockPanel><Expander Header="查看详细记录（最多 200 条）" Margin="0,11,0,0"><ListBox x:Name="ProgressLogList" ItemsSource="{Binding ProgressEntries}" MaxHeight="150" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" BorderBrush="{StaticResource BorderBrush}"/></Expander></StackPanel></Border>
                        <StackPanel Visibility="{Binding CanUsePortable, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,14,0,0"><TextBlock Text="官方部署失败后可尝试实验性解包；可能缺少更新、通知、协议关联和部分沙盒能力。" TextWrapping="Wrap" Foreground="#B88230"/><Button Content="尝试实验性解包运行" Click="PortableInstallButton_Click" IsEnabled="{Binding CanRunPortable}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ConfigureStepPanel" Visibility="{Binding IsConfigureStep, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid><StackPanel><TextBlock Text="配置 DeepSeek" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="先按分步引导准备 Key，再粘贴验证。引导可以随时关闭，不会阻止继续。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,170,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="ShowGuideButton" Content="查看操作引导" Click="ShowGuideButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/></Grid>
                        <Border Style="{StaticResource InfoAlert}" Margin="0,16,0,0"><StackPanel><TextBlock Text="登录 → 实名认证 → 充值 → 创建 Key" FontWeight="SemiBold" Foreground="#337ECC"/><TextBlock Text="所有身份资料和支付操作只在 DeepSeek 官方网页完成，本助手不会读取。" Foreground="#337ECC" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border x:Name="NetworkHelperCard" Style="{StaticResource InnerBorder}" Margin="0,14,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="可选 · 网络辅助" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="如果当前网络无法直接连接所需服务，可粘贴你有权使用的 HTTPS 订阅。组件优先从本站镜像下载，不需要访问 GitHub。不会启用 TUN、修改 DNS、路由或防火墙。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <PasswordBox x:Name="SubscriptionUrlBox" PasswordChar="●" ToolTip="HTTPS 订阅地址只保存到 Windows 凭据管理器"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="EnableNetworkHelperButton" Content="启用网络辅助" Click="EnableNetworkHelperButton_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="SelectNetworkNodeButton" Content="选择节点" Click="SelectNetworkNodeButton_Click" IsEnabled="False"/>
                                    <Button x:Name="DisableNetworkHelperButton" Content="停用并恢复原网络" Click="DisableNetworkHelperButton_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="NetworkHelperProgressBar" Height="7" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                                <TextBlock x:Name="NetworkHelperStatusText" Text="尚未启用。订阅地址和节点内容不会写入日志。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="DeepSeek API Key" FontWeight="SemiBold" Margin="0,20,0,7"/><PasswordBox x:Name="ApiKeyBox" PasswordChar="●" ToolTip="粘贴 sk- 开头的 DeepSeek API Key"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="验证并配置 Codex" Click="ConfigureButton_Click" IsEnabled="{Binding CanConfigure}" Style="{StaticResource SuccessButton}"/><Button Content="返回安装步骤" Click="ReturnToInstallButton_Click" IsEnabled="{Binding CanConfigure}"/></StackPanel>
                        <Border Style="{StaticResource InfoAlert}" Margin="0,14,0,0"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#337ECC"/></Border>
                    </StackPanel>
                </Border>

                <Border x:Name="CompleteStepPanel" Visibility="{Binding IsCompleteStep, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource CardBorder}">
                    <StackPanel><TextBlock Text="配置完成" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="下面三项均已完成，可以启动 Codex。" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,14"/>
                        <Border Background="#F0F9EB" BorderBrush="#B3E19D" BorderThickness="1" CornerRadius="4" Padding="14"><StackPanel><TextBlock Text="✓ OpenAI Codex 已安装或准备完成" Foreground="#529B2E" Margin="0,0,0,6"/><TextBlock Text="✓ DeepSeek API Key 已保存到 Windows 凭据管理器" Foreground="#529B2E" Margin="0,0,0,6"/><TextBlock Text="✓ Codex 配置文件与模型目录已写入" Foreground="#529B2E"/></StackPanel></Border>
                        <TextBlock Text="{Binding CompletionNextStep}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,14"/><StackPanel Orientation="Horizontal"><Button x:Name="LaunchCodexButton" Content="{Binding LaunchButtonText}" Click="LaunchButton_Click" IsEnabled="{Binding CanLaunch}" Style="{StaticResource PrimaryButton}"/><Button x:Name="GettingStartedButton" Content="查看首次使用教程" Click="OpenLink_Click" Tag="https://developers.openai.com/codex/"/><Button x:Name="CloseAssistantButton" Content="关闭安装助手" Click="CloseButton_Click"/></StackPanel>
                        <Border x:Name="AdvertisementCard" Visibility="{Binding IsAdvertisementVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FDF6EC" BorderBrush="#F3D19E" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="AdvertisementImage" Width="128" Height="82" Stretch="UniformToFill" Margin="0,0,14,0" Visibility="Collapsed"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="推广" Foreground="#B88230" FontSize="12"/><TextBlock Text="{Binding CurrentAdvertisement.Title}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"/><TextBlock Text="{Binding CurrentAdvertisement.Body}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,7"/><Button x:Name="AdvertisementButton" Content="{Binding CurrentAdvertisement.CtaText}" Click="AdvertisementButton_Click" HorizontalAlignment="Left" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningBrush}" Foreground="White"/></StackPanel><Button x:Name="DismissAdvertisementButton" Grid.Column="2" Content="×" Click="DismissAdvertisementButton_Click" ToolTip="关闭推广" Width="30" Height="30" Padding="0" Margin="0" VerticalAlignment="Top"/></Grid></Border>
                        <Expander x:Name="AdvancedCleanupExpander" Header="高级操作：检测与清理安装数据" Margin="0,20,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="可查看每项位置和大小，再选择删除内容；敏感项目默认不勾选。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/><Button x:Name="CleanupEverythingButton" Content="查看并选择清理内容" Click="CleanupEverythingButton_Click" IsEnabled="{Binding CanCleanup}" Style="{StaticResource DangerTextButton}" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel></Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/></DockPanel></Border>
    </Grid>
</Window>
