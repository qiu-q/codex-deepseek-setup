<Window x:Class="CodexDeepSeekSetup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexDeepSeekSetup.App"
        Title="Codex + DeepSeek 安装助手" Width="920" Height="760"
        MinWidth="800" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="#F4F7FB" FontFamily="Microsoft YaHei UI"
        Loaded="MainWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#111827" Padding="30,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Codex + DeepSeek 安装助手" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="先下载并校验官方文件，再单独安装，最后配置 DeepSeek。" Foreground="#CBD5E1" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding InstallationSummary}" Foreground="#86EFAC" Margin="0,6,210,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="OpenMaintenanceButton"
                        Content="检测安装与清理数据"
                        Click="OpenMaintenanceButton_Click"
                        IsEnabled="{Binding CanOpenMaintenance}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Background="#1F2937"
                        BorderBrush="#475569"
                        Foreground="White" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="30,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#2563EB">
                        <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="下载与安装" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Rectangle Grid.Column="1" Width="42" Height="1" Fill="#CBD5E1" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#0F766E">
                        <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="配置 DeepSeek" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Rectangle Grid.Column="3" Width="42" Height="1" Fill="#CBD5E1" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#7C3AED">
                        <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="完成" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24">
                <Border Visibility="{Binding NeedsBuiltInAdministratorCompatibility, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="内置 Administrator 需要开启兼容模式" FontSize="17" FontWeight="SemiBold" Foreground="#9A3412" />
                            <TextBlock Text="助手会启用管理员批准模式，登记一次性自动重开，并在 15 秒后重启 Windows。请先保存其他程序中的工作；如需取消已安排的重启，可按 Win+R 运行 shutdown /a。"
                                       TextWrapping="Wrap" Margin="0,6,16,0" Foreground="#7C2D12" />
                        </StackPanel>
                        <Button x:Name="EnableAdministratorCompatibilityButton"
                                Grid.Column="1"
                                Content="启用兼容并重启"
                                Click="EnableAdministratorCompatibilityButton_Click"
                                IsEnabled="{Binding CanEnableBuiltInAdministratorCompatibility}"
                                Background="#EA580C"
                                Foreground="White"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="InstallStepPanel"
                        Visibility="{Binding IsInstallStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="White" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="第 1 步 · 下载并安装 Codex" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="下载与安装是两个独立阶段。先完成左侧下载；看到“校验通过”后，再点击右侧安装。安装失败时可直接重试，不会重复下载。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#475569" />
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,16,0,4">
                            <StackPanel>
                                <TextBlock Text="安装阶段可能出现 Windows 管理员授权窗口。" FontWeight="SemiBold" Foreground="#1E40AF" />
                                <TextBlock Text="授权窗口要求的是 Windows 管理员密码；DeepSeek API Key 要到下一步再填写。" Margin="0,4,0,0" Foreground="#1E3A8A" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="保存与安装位置" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="安装包默认保存在本助手所在目录的 Downloads 文件夹，可自行更改。Codex 桌面应用由 Windows 管理，不能选择任意文件夹；这里可选择符合条件的磁盘，优先使用 D 盘。" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="#475569" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="安装包保存到" VerticalAlignment="Center" />
                                    <TextBox x:Name="DownloadDirectoryTextBox" Grid.Column="1" Text="{Binding DownloadDirectory, Mode=OneWay}" IsReadOnly="True" Padding="9,7" VerticalContentAlignment="Center" />
                                    <Button x:Name="BrowseDownloadDirectoryButton" Grid.Column="2" Content="选择目录" Click="BrowseDownloadDirectoryButton_Click" Margin="10,0,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Codex 安装磁盘" VerticalAlignment="Center" />
                                    <ComboBox x:Name="InstallDriveComboBox"
                                              Grid.Column="1"
                                              ItemsSource="{Binding InstallDriveChoices}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="RootPath"
                                              SelectedValue="{Binding SelectedInstallDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Padding="8,6" />
                                </Grid>
                                <Border Background="#ECFDF5" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding InstallationSummary}" TextWrapping="Wrap" Foreground="#065F46" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#BFDBFE" BorderThickness="1" Background="#F8FBFF" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="DownloadPhaseLabel" Text="阶段 1 · 下载官方文件" FontSize="17" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                    <TextBlock Text="下载 MSIX 和离线许可证，并检查包身份与 OpenAI 数字签名。此阶段不需要管理员授权。" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#475569" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="DownloadCodexButton" Content="下载并校验" Click="DownloadButton_Click" IsEnabled="{Binding CanDownload}" Background="#2563EB" Foreground="White" />
                                        <Button Content="重新检查电脑" Click="CheckButton_Click" IsEnabled="{Binding CanDownload}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#A7F3D0" BorderThickness="1" Background="#F7FFFB" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="InstallPhaseLabel" Text="阶段 2 · 安装已校验文件" FontSize="17" FontWeight="SemiBold" Foreground="#047857" />
                                    <TextBlock Text="使用刚才校验通过的文件部署 Codex。只有此阶段可能请求 Windows 管理员授权。" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="#475569" />
                                    <Button x:Name="InstallCodexButton" Content="安装 Codex" Click="InstallButton_Click" IsEnabled="{Binding CanInstall}" Background="#059669" Foreground="White" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="ProgressPanel" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ProgressTitle}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProgressDetail}" TextWrapping="Wrap" Margin="0,5,0,12" Foreground="#475569" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CurrentFileName}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TransferSummary}" Margin="16,0,0,0" Foreground="#475569" />
                                </Grid>
                                <ProgressBar x:Name="FileProgressBar" Height="9" Minimum="0" Maximum="100" Value="{Binding FileProgress, Mode=OneWay}" IsIndeterminate="{Binding IsFileProgressIndeterminate, Mode=OneWay}" Margin="0,7,0,12" />
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="总体进度" Foreground="#64748B" Margin="12,0,0,0" />
                                    <ProgressBar x:Name="OverallProgressBar" Height="7" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" />
                                </DockPanel>
                                <Expander Header="查看详细记录（最多保留 200 条）" Margin="0,12,0,0">
                                    <ListBox x:Name="ProgressLogList" ItemsSource="{Binding ProgressEntries}" MaxHeight="150" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" BorderBrush="#CBD5E1" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding CanUsePortable, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,14,0,0">
                            <Separator />
                            <TextBlock Text="官方系统部署没有成功时，可尝试实验性解包运行。此模式可能缺少自动更新、通知、协议关联和部分沙盒能力。" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#B45309" />
                            <Button Content="尝试实验性解包运行" Click="PortableInstallButton_Click" IsEnabled="{Binding CanRunPortable}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ConfigureStepPanel"
                        Visibility="{Binding IsConfigureStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="White" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <TextBlock Text="第 2 步 · 配置 DeepSeek" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="按下面顺序完成，API Key 只会保存在当前 Windows 用户的凭据管理器中。点击验证后通常在 30 秒内完成；失败会直接显示具体原因。" TextWrapping="Wrap" Margin="0,10,0,16" Foreground="#475569" />
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                            <local:DeepSeekVisualGuide x:Name="DeepSeekVisualGuidePanel" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding DeepSeekGuideItems}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionLabel}" Tag="{Binding Url}" Click="OpenLink_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="粘贴 DeepSeek API Key" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <PasswordBox x:Name="ApiKeyBox" Height="42" Padding="11,8" PasswordChar="●" ToolTip="粘贴 sk- 开头的 DeepSeek API Key" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="验证并配置 Codex" Click="ConfigureButton_Click" IsEnabled="{Binding CanConfigure}" Background="#059669" Foreground="White" />
                            <Button Content="返回第 1 步测试下载" Click="ReturnToInstallButton_Click" IsEnabled="{Binding CanConfigure}" />
                        </StackPanel>
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#1E3A8A" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="CompleteStepPanel"
                        Visibility="{Binding IsCompleteStep, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="White" CornerRadius="12" Padding="28">
                    <StackPanel>
                        <Border Width="58" Height="58" CornerRadius="29" Background="#DCFCE7" HorizontalAlignment="Left">
                            <TextBlock Text="✓" FontSize="30" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Codex 已配置完成" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,14">
                            <StackPanel>
                                <TextBlock Text="✓ OpenAI Codex 已安装或已准备完成" Foreground="#166534" Margin="0,0,0,5" />
                                <TextBlock Text="✓ DeepSeek API Key 已安全保存到 Windows 凭据管理器" Foreground="#166534" Margin="0,0,0,5" />
                                <TextBlock Text="✓ Codex 配置文件与模型目录已写入" Foreground="#166534" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding CompletionNextStep}" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#475569" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LaunchCodexButton" Content="{Binding LaunchButtonText}" Click="LaunchButton_Click" IsEnabled="{Binding CanLaunch}" Background="#2563EB" Foreground="White" />
                            <Button x:Name="GettingStartedButton"
                                    Content="查看首次使用教程"
                                    Click="OpenLink_Click"
                                    Tag="https://developers.openai.com/codex/" />
                            <Button x:Name="CloseAssistantButton" Content="关闭安装助手" Click="CloseButton_Click" />
                        </StackPanel>

                        <Border x:Name="AdvertisementCard"
                                Visibility="{Binding IsAdvertisementVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                CornerRadius="10" Padding="16" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="AdvertisementImage" Width="128" Height="82" Stretch="UniformToFill" Margin="0,0,14,0" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="推广" Foreground="#9A3412" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentAdvertisement.Title}" FontWeight="SemiBold" FontSize="17" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CurrentAdvertisement.Body}" TextWrapping="Wrap" Foreground="#475569" Margin="0,5,0,7" />
                                    <Button x:Name="AdvertisementButton"
                                            Content="{Binding CurrentAdvertisement.CtaText}"
                                            Click="AdvertisementButton_Click"
                                            HorizontalAlignment="Left"
                                            Background="#EA580C" Foreground="White" />
                                </StackPanel>
                                <Button x:Name="DismissAdvertisementButton" Grid.Column="2" Content="×" Click="DismissAdvertisementButton_Click"
                                        ToolTip="关闭推广" Width="28" Height="28" Padding="0" VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <Expander x:Name="AdvancedCleanupExpander" Header="高级操作：检测与清理安装数据" Margin="0,22,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="可查看每项位置和大小，再选择要删除的内容。会影响会话或凭据的项目默认不会勾选。" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="#991B1B" />
                                <Button x:Name="CleanupEverythingButton"
                                        Content="查看并选择清理内容"
                                        Click="CleanupEverythingButton_Click"
                                        IsEnabled="{Binding CanCleanup}"
                                        HorizontalAlignment="Left"
                                        Foreground="#B91C1C" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="30,14">
            <DockPanel>
                <Ellipse Width="10" Height="10" Fill="#2563EB" Margin="0,0,10,0" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
