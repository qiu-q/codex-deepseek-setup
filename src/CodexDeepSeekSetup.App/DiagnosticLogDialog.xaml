<Window x:Class="CodexDeepSeekSetup.App.DiagnosticLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="诊断日志" Width="760" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI" Activated="Window_Activated">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="诊断日志" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="可以直接复制给技术人员。API Key、Bearer 凭据和订阅地址查询参数会自动隐藏。"
                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
            <TextBlock x:Name="DiagnosticLogPathText" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
        </StackPanel>

        <TextBox x:Name="DiagnosticLogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" Padding="12" />

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="DiagnosticLogActionStatus" VerticalAlignment="Center"
                       Foreground="{StaticResource SuccessBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyAllDiagnosticLogButton" Content="复制全部日志"
                        Click="CopyAllDiagnosticLogButton_Click" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="ExportDiagnosticLogButton" Content="导出到桌面"
                        Click="ExportDiagnosticLogButton_Click" />
                <Button Content="关闭" Click="CloseButton_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
