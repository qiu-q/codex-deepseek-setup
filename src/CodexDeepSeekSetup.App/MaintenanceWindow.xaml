<Window x:Class="CodexDeepSeekSetup.App.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 检测与清理" Width="900" Height="700"
        MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" FontFamily="Microsoft YaHei UI"
        Loaded="MaintenanceWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,18">
            <StackPanel>
                <TextBlock Text="Codex 安装、数据与清理" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="只扫描当前 Windows 用户和本助手已知目录；不会显示或导出 API Key。" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Codex 桌面应用目标盘" VerticalAlignment="Center" />
                <ComboBox x:Name="MaintenanceDriveComboBox"
                          Grid.Column="1" Margin="12,0,0,0" Padding="8,6"
                          ItemsSource="{Binding InstallDriveChoices}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="RootPath"
                          SelectedValue="{Binding SelectedInstallDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="迁移已安装 Codex" Click="MoveCodexButton_Click" IsEnabled="{Binding CanRunActions}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="3" Text="Windows 管理应用位置；不会更改其他应用的默认盘。" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap" />
                <Button Grid.Column="4" Content="重新扫描" Click="RefreshButton_Click" IsEnabled="{Binding CanRunActions}" Margin="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="检测到的内容" FontSize="20" FontWeight="SemiBold" />
            <Border Grid.Row="1" Background="White" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,10,0,0">
                <ListBox x:Name="ArtifactList" ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" Padding="6">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EBEEF5" BorderThickness="0,0,0,1" Padding="12,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,4,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="  会删除用户数据" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDestructiveUserData}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Location}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding PermissionText}" Foreground="#B88230" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Top" Margin="14,2,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Row="2" Background="#FDF6EC" BorderBrush="#F3D19E" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                <TextBlock Text="删除 Codex 配置、插件与会话、Windows 应用数据、API Key 或本助手自身前会再次确认。未勾选内容不会删除。" TextWrapping="Wrap" Foreground="#B88230" />
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,3,12,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="关闭" Click="CloseButton_Click" IsEnabled="{Binding CanRunActions}" />
                <Button x:Name="CleanupSelectedButton" Grid.Column="2" Content="删除已选择内容" Click="CleanupSelectedButton_Click" IsEnabled="{Binding CanRunActions}" Background="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" Foreground="White" Margin="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
