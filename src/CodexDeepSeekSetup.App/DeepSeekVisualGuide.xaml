<UserControl x:Class="CodexDeepSeekSetup.App.DeepSeekVisualGuide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <UserControl.Resources>
        <Style x:Key="GuideCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE3EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#2563EB" />
        </Style>
        <Style x:Key="MockInput" TargetType="Border">
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="按图完成 DeepSeek 开放平台准备" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="四步都在 DeepSeek 官方网页完成；本助手不会读取身份证资料，也不会替你保存网页密码。"
                   TextWrapping="Wrap" Margin="0,5,0,8" Foreground="#475569" />
        <UniformGrid Columns="2">
            <Border Style="{StaticResource GuideCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}" DockPanel.Dock="Left">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="登录或注册" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Height="142" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#E2E8F0">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <Ellipse Width="7" Height="7" Fill="#FB7185" Margin="0,0,4,0" />
                                    <Ellipse Width="7" Height="7" Fill="#FBBF24" Margin="0,0,4,0" />
                                    <Ellipse Width="7" Height="7" Fill="#4ADE80" />
                                    <TextBlock Text="platform.deepseek.com/sign_in" FontSize="9" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#64748B" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DeepSeek 开放平台" FontWeight="Bold" FontSize="11" Margin="0,0,0,7" />
                                    <Border Style="{StaticResource MockInput}">
                                        <TextBlock Text="+86  输入手机号" FontSize="9" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Style="{StaticResource MockInput}">
                                        <TextBlock Text="输入验证码     发送验证码" FontSize="9" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Height="22" CornerRadius="11" Background="#111827">
                                        <TextBlock Text="登录" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="6">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="▦" FontFamily="Segoe UI Symbol" FontSize="38" HorizontalAlignment="Center" />
                                        <TextBlock Text="微信扫码登录" FontSize="8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="输入手机号收验证码，或用微信扫码；未注册手机号会按官方页面提示注册。"
                               TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" Foreground="#475569" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GuideCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}" DockPanel.Dock="Left" Background="#0F766E">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="完成实名认证" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Height="142" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#0F172A" CornerRadius="6" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="账户中心" Foreground="White" FontWeight="Bold" FontSize="10" Margin="0,0,0,10" />
                                    <Border Height="8" Background="#334155" CornerRadius="4" Margin="0,0,14,7" />
                                    <Border Height="8" Background="#14B8A6" CornerRadius="4" Margin="0,0,5,7" />
                                    <Border Height="8" Background="#334155" CornerRadius="4" Margin="0,0,18,7" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#CCFBF1">
                                            <TextBlock Text="✓" FontSize="19" Foreground="#0F766E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock Text="实名认证" FontWeight="Bold" FontSize="11" />
                                            <TextBlock Text="按页面提示填写" FontSize="9" Foreground="#64748B" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Height="24" Background="#0F766E" CornerRadius="5" Margin="0,13,0,0">
                                        <TextBlock Text="去认证" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="身份证资料仅在官方网页填写" FontSize="8" Foreground="#B45309" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="登录后按账户中心或页面弹窗完成认证；不要把姓名、身份证号填进本助手。"
                               TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" Foreground="#475569" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GuideCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}" DockPanel.Dock="Left" Background="#D97706">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="充值 API 余额" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Height="142" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="7" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="账户余额" FontSize="10" Foreground="#78716C" />
                                <TextBlock Text="¥ 0.00" FontSize="25" FontWeight="Bold" Margin="0,4,0,10" />
                                <Border Height="28" Width="84" HorizontalAlignment="Left" Background="#D97706" CornerRadius="5">
                                    <TextBlock Text="充值" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="10" BorderBrush="#FDE68A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="充值前确认" FontWeight="Bold" FontSize="10" />
                                    <TextBlock Text="• 官方计费说明" FontSize="9" Margin="0,8,0,0" />
                                    <TextBlock Text="• 账户和金额" FontSize="9" Margin="0,5,0,0" />
                                    <TextBlock Text="• 支付结果" FontSize="9" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="API 调用按量计费。进入官方充值页，确认账户、金额与计费说明后再支付。"
                               TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" Foreground="#475569" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GuideCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}" DockPanel.Dock="Left" Background="#7C3AED">
                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="创建并复制 API Key" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Height="142" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="7" Padding="12">
                        <Grid>
                            <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="7" Padding="12" Margin="12,5">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="API Keys" FontWeight="Bold" FontSize="12" />
                                        <Border DockPanel.Dock="Right" Background="#7C3AED" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="创建 API key" Foreground="White" FontSize="9" />
                                        </Border>
                                    </DockPanel>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,12,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#EDE9FE" CornerRadius="4" Padding="7,3">
                                                <TextBlock Text="复制" Foreground="#6D28D9" FontSize="9" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="新创建的密钥" FontSize="9" Foreground="#64748B" />
                                                <TextBlock Text="sk-••••••••••••" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="密钥通常只完整显示一次" FontSize="8" Foreground="#B45309" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="点击“创建 API key”后立即复制；回到本助手，粘贴到下方输入框再验证。"
                               TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0" Foreground="#475569" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
